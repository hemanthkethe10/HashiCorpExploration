# Azure AD / Entra credentials
TENANT_ID=your-tenant-id
CLIENT_ID=your-client-id
CLIENT_SECRET=your-client-secret

# Microsoft Graph API scope
GRAPH_SCOPE=https://graph.microsoft.com/.default

# Agent Identity Blueprint Principal
# Object ID of the microsoft.graph.agentIdentityBlueprintPrincipal service principal
AGENT_BLUEPRINT_PRINCIPAL_ID=your-blueprint-principal-object-id

# Agent sponsor user — object ID of the user set as sponsor on agent identities
AGENT_SPONSOR_USER_ID=your-sponsor-user-object-id

# Database connection
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=lumen_sync
DATABASE_USER=postgres
DATABASE_PASSWORD=your-db-password
