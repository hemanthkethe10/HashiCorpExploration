# Vault OIDC Configuration
VAULT_ADDR=http://127.0.0.1:8200
VAULT_NAMESPACE=
PROVIDER_NAME=default
CLIENT_ID=<client_id_here>
CLIENT_SECRET=<secret_here>
REDIRECT_URI=<redirect_uri>

# Vault Token Creation Configuration
VAULT_ROOT_TOKEN=<vault_root_token_here>
VAULT_TOKEN_POLICIES=boundary-controller
VAULT_TOKEN_PERIOD=24h

# Boundary Configuration
BOUNDARY_ADDR=http://127.0.0.1:9200
BOUNDARY_TOKEN=<boundary_token_here>

# Authorization Middleware Configuration
VAULT_AUTH_PATH=<path-to-secret>

# Logging Configuration
# Valid values: DEBUG, INFO, WARNING, ERROR, CRITICAL (default: INFO)
LOG_LEVEL=INFO

# AWS Configuration
AWS_ACCESS_KEY_ID=<your_aws_access_key_id>
AWS_SECRET_ACCESS_KEY=<your_aws_secret_access_key>
AWS_REGION=us-east-1
