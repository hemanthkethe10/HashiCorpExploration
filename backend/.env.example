# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Entra ID app registration (service principal) — DefaultAzureCredential + Graph PIM
AZURE_TENANT_ID=<tenant-id>
AZURE_CLIENT_ID=<client-id>
AZURE_CLIENT_SECRET=<client-secret>
# Graph app permission required: RoleAssignmentSchedule.ReadWrite.Directory (or equivalent PIM)

# Cosmos DB (Mongo API) — data plane token scope https://cosmos.azure.com/.default
COSMOS_ACCOUNT_NAME=user-onboarding-db
MONGO_DB_NAME=debugging
MONGO_COLLECTION_NAME=data

# API server
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:5173
